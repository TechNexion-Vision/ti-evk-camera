/*
 * TechNexion TEVS camera module overlay for TI AM62A
 *
 * Copyright (C) 2022 Texas Instruments Incorporated - https://www.ti.com/
 */
/dts-v1/;
/plugin/;
#include <dt-bindings/gpio/gpio.h>
&main_i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	i2c-switch@71 {
		compatible = "nxp,pca9543";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x71>;
		/* CAM port */
		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			pca9554_a27_0: pca9554@27 {
				compatible = "nxp,pca9554";
				pinctrl-names = "default";
				reg = <0x27>;
				gpio-controller;
				#gpio-cells = <2>;
				status = "okay";
				gpio-line-names = "EXPOSURE_TRIG_IN1", "FLASH_OUT1",
						  "CAM_SHUTTER1", "XVS1", "CSI1_PDB",
						  "CSI1_INT", "INFO_TRIG_IN1", "CSI1_RST_N";
			};
			tevs_0: tevs@48 {
				compatible = "tn,tevs";
				reg = <0x48>;
				/* TI AM62A board-specific GPIO routing. */
				standby-gpios = <&pca9554_a27_0 2 GPIO_ACTIVE_HIGH>;
				reset-gpios = <&exp1 13 GPIO_ACTIVE_HIGH>;
				/* Compatibility with the older TI TEVS driver. */
				data-lanes = <4>;
				data-frequency = <800>;
				continuous-clock = <0>;
                supports-over-4k-res;
				status = "okay";
				port {
					csi2_cam0: endpoint {
						remote-endpoint = <&csi2rx0_in_sensor>;
						/* Standard properties used by the merged driver. */
						link-frequencies = /bits/ 64 <400000000>;
						clock-lanes = <0>;
						data-lanes = <1 2 3 4>;
						clock-noncontinuous;
					};
				};
			};
		};
	};
};
&cdns_csi2rx0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		csi0_port0: port@0 {
			reg = <0>;
			status = "okay";
			csi2rx0_in_sensor: endpoint {
				remote-endpoint = <&csi2_cam0>;
				bus-type = <4>; /* MIPI CSI-2 D-PHY */
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				clock-noncontinuous;
			};
		};
	};
};
&dphy0 {
	status = "okay";
};
&ti_csi2rx0 {
	status = "okay";
};
